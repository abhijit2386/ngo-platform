# Yogdaan PRODUCTION settings (OCI server). Copy to config/yogdaan.env.prod on the laptop (gitignored), fill the
# REQUIRED lines, then deploy (scripts/deploy-cloud.ps1). Never commit the filled file; never paste keys in chat.
# Lines marked GENERATED may stay empty: the server creates strong random values on the first install and keeps them.

# ---- domain (REQUIRED) - DNS A records for these names must point to the server's public IP
DOMAIN=yogdaan.co.in
API_HOST=api.yogdaan.co.in
AUTH_HOST=auth.yogdaan.co.in
# e-mail for Let's Encrypt (certificate expiry notices)
ACME_EMAIL=

# ---- public addresses used in links, receipts and the app
PUBLIC_API_BASE=https://api.yogdaan.co.in
PUBLIC_API_URL=https://api.yogdaan.co.in
PUBLIC_WEB_URL=https://yogdaan.co.in
RECEIPT_BRANDING=Generated with Yogdaan (yogdaan.co.in) - donations and accounts app for NGOs

# ---- e-mail (REQUIRED) - e.g. OCI Email Delivery: smtp.email.ap-mumbai-1.oci.oraclecloud.com, port 587, STARTTLS,
# SMTP credentials from your OCI user, approved sender no-reply@yogdaan.co.in (+ SPF/DKIM DNS records)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=no-reply@yogdaan.co.in
MAIL_FROM_NAME=Yogdaan

# ---- files: OCI Object Storage (S3 Compatibility API) (REQUIRED)
# endpoint: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com ; keys: Profile > Customer Secret Keys.
# The buckets must be in the tenancy's "S3 compatibility" compartment (Tenancy > Object Storage settings).
STORAGE_TYPE=s3
S3_ENDPOINT=
S3_REGION=ap-mumbai-1
S3_BUCKET=yogdaan-files
S3_BACKUP_BUCKET=yogdaan-backups
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- sign-in (Keycloak)
KEYCLOAK_REALM=ngo
KEYCLOAK_URL=http://127.0.0.1:8180
KEYCLOAK_ISSUERS=https://auth.yogdaan.co.in/realms/ngo
KEYCLOAK_JWKS=http://127.0.0.1:8180/realms/ngo/protocol/openid-connect/certs
KEYCLOAK_ADMIN_USER=yogdaan-admin
KEYCLOAK_ADMIN_CLIENT_ID=ngo-identity-admin
# GENERATED
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_DB_PASSWORD=
# social sign-in comes later (Google / Facebook apps need the live HTTPS domain)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---- database and service secrets - GENERATED
DB_PASSWORD=
INTERNAL_TOKEN=
RECEIPT_LINK_SECRET=
DOCUMENT_LINK_SECRET=
OTP_SECRET=
PAYMENTS_MOCK_SECRET=
BILLING_WEBHOOK_SECRET=

# ---- switches. Test/mock features stay OFF in production: a mock payment would create real-looking paid
# donations and 80G receipts. Turn on only for a closed test period, knowingly.
PAYMENTS_MOCK_ENABLED=false
BILLING_PROVIDER=mock
BILLING_MOCK_ENABLED=false
BILLING_SELLER_NAME=Yogdaan
BILLING_SELLER_GSTIN=
CAMPAIGN_TEST_DONATIONS=false
# no SMS provider yet: phone OTP verification does not work in production until one is added
SMS_PROVIDER=dev-mailbox

# ---- runtime (same as the laptop: Eureka discovery, events over HTTP, no RabbitMQ)
DISCOVERY_ENABLED=true
EUREKA_URL=http://127.0.0.1:8761/eureka
EUREKA_INSTANCE_HOST=127.0.0.1
EVENTS_TRANSPORT=http
LOG_FORMAT=ecs
OTLP_EXPORT=false
