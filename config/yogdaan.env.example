# =====================================================================================================================
#  Yogdaan - MASTER CONFIGURATION (one file for every service, the login server and the helper scripts)
# =====================================================================================================================
#  How to use
#    1. Copy this file to  config/yogdaan.env  (that copy is in .gitignore: it is NEVER committed).
#    2. Fill in the real values. Leave a line empty to keep the built-in development default.
#    3. Local PC:  scripts\start-local.ps1 loads config\yogdaan.env automatically.
#       Server:    copy it to /etc/yogdaan/yogdaan.env (chmod 600) - every systemd service reads it.
#    4. After changing email or Google/Facebook values, run scripts\configure-login.ps1 once so the login server
#       (Keycloak) picks them up as well.
#
#  Rules
#    - Real passwords and keys live ONLY in yogdaan.env (or the server's /etc/yogdaan/yogdaan.env), never in code,
#      chat, e-mail or screenshots. Rotate a key immediately if it was ever shared.
#    - Every "change-me" value below must be replaced with a long random value before going live
#      (e.g. PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))  or  openssl rand -base64 32).
# =====================================================================================================================

# ---- App and addresses ----------------------------------------------------------------------------------------------
# Public addresses. Local development keeps http://localhost:8080; live: https://api.yogdaan.co.in etc.
PUBLIC_API_BASE=http://localhost:8080
PUBLIC_API_URL=http://localhost:8080
PUBLIC_WEB_URL=http://localhost:8080
# Small credit printed at the foot of every receipt (blank = off).
RECEIPT_BRANDING=Generated with Yogdaan (yogdaan.co.in) - donations and accounts app for NGOs

# ---- E-mail (notification-service sends every e-mail; the login server uses the same account) ----------------------
# Local development: Mailpit (localhost:1025, no login). Live: an SMTP relay, for example
#   Oracle Cloud Email Delivery: smtp.email.ap-hyderabad-1.oci.oraclecloud.com, port 587, STARTTLS, SMTP credentials
#   Gmail (testing only):        smtp.gmail.com, port 587, STARTTLS, an App Password (not the Gmail password)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@yogdaan.co.in
MAIL_FROM_NAME=Yogdaan

# ---- Sign in with Google / Facebook (used by the login server, Keycloak) -------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (type: Web application)
#   Authorised redirect URI: <KEYCLOAK_URL>/realms/ngo/broker/google/endpoint
# Meta for Developers > your app > Facebook Login > Settings
#   Valid OAuth redirect URI: <KEYCLOAK_URL>/realms/ngo/broker/facebook/endpoint
# Leave empty to hide that button on the sign-in page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---- Login server (Keycloak) ----------------------------------------------------------------------------------------
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=ngo
# Used by configure-login.ps1 (admin console account).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=dev-only-admin
# identity-service talks to Keycloak with this client (create/delete users).
KEYCLOAK_ADMIN_CLIENT_ID=ngo-identity-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-only-identity-admin-secret

# ---- Database (PostgreSQL) ------------------------------------------------------------------------------------------
DB_PASSWORD=dev-only-password

# ---- Secrets between services and in signed links (change-me before going live) -----------------------------------
INTERNAL_TOKEN=dev-internal-token-change-me
RECEIPT_LINK_SECRET=dev-receipt-link-secret-change-me
DOCUMENT_LINK_SECRET=dev-only-document-link-secret-change-me
OTP_SECRET=dev-only-otp-secret-change-me

# ---- File storage (one private bucket for all NGOs) -----------------------------------------------------------------
# local = files on disk (development). s3 = S3-compatible object storage (Oracle Cloud Object Storage, MinIO, ...).
STORAGE_TYPE=local
S3_BUCKET=ngo-files
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Payments (donations go straight to each NGO's own Razorpay/Cashfree account) ----------------------------------
# Development uses a test provider: no real money. Turn the test provider off before going live.
PAYMENTS_MOCK_ENABLED=true
PAYMENTS_MOCK_SECRET=dev-payments-webhook-secret-change-me

# ---- Subscription billing (NGOs paying Yogdaan) --------------------------------------------------------------------
BILLING_PROVIDER=mock
BILLING_MOCK_ENABLED=true
BILLING_WEBHOOK_SECRET=dev-billing-webhook-secret-change-me
BILLING_SELLER_NAME=Yogdaan
BILLING_SELLER_GSTIN=GSTIN-NOT-CONFIGURED

# ---- SMS (phone verification codes) ---------------------------------------------------------------------------------
# dev-mailbox = codes are shown in the developer mailbox instead of being sent. Real SMS needs a DLT-registered
# sender and template (TRAI rules), registered with the new name "Yogdaan".
SMS_PROVIDER=dev-mailbox
